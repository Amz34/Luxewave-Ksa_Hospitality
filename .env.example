# ─── Copy this file to .env and fill in your keys ───
# cp .env.example .env

# DeepSeek API key (OpenAI-compatible) — https://platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Optional overrides (only if you use a different provider)
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.deepseek.com

# Server port
PORT=3001
